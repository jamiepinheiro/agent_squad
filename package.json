    "release": "python3 scripts/release.py"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "libraries/kernel",
    "libraries/surfaces/imessage",
